    def _bind_shortcuts(self) -> None:
        self.bind("<F5>", lambda _event: self.refresh_all())
        self.bind("<Control-l>", self._focus_lookup)
        self.bind("<Control-L>", self._focus_lookup)
        self.bind("<Control-s>", lambda _event: self.export_report())
        self.bind("<Control-S>", lambda _event: self.export_report())
