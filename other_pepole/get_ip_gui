APP_NAME = "NetScope IP Utility"
APP_VERSION = "2.0.0"
HTTP_TIMEOUT = 5.0

PUBLIC_IPV4_URL = "https://api.ipify.org?format=json"
PUBLIC_IPV6_URL = "https://api6.ipify.org?format=json"

ROUTE_PROBES = {
    4: (socket.AF_INET, ("1.1.1.1", 443)),
    6: (socket.AF_INET6, ("2606:4700:4700::1111", 443, 0, 0)),
}

