        self.bind("<Control-Shift-c>", lambda _event: self.copy_report())

    # ----------------------------
    # Async execution
    # ----------------------------

    def _submit(self, key: str, function, success_callback) -> None:
        if key in self.pending:
            return

        self.pending.add(key)
        future = self.executor.submit(function)

        def completed(done_future) -> None:
            try:
                result = done_future.result()
            except BaseException as exc:
                self.event_queue.put(("error", key, success_callback, exc))
            else:
                self.event_queue.put(("success", key, success_callback, result))

        future.add_done_callback(completed)

    def _poll_worker_events(self) -> None:
        try:
            while True:
                kind, key, callback, payload = self.event_queue.get_nowait()
                self.pending.discard(key)

                if kind == "success":
                    callback(payload)
                else:
                    self._task_failed(key, payload)

                if not self.pending:
                    self.status_var.set(
                        f"Ready  |  Last completed {datetime.now().strftime('%H:%M:%S')}"
                    )
        except queue.Empty:
            pass

        if self.winfo_exists():
            self.after(80, self._poll_worker_events)

    # ----------------------------
    # Refresh and result handling
    # ----------------------------

    def refresh_all(self) -> None:
        if self.pending:
            self.status_var.set(
                f"Refresh already running ({len(self.pending)} task(s) remaining)"
            )
            return

        self.status_var.set("Refreshing network information…")

        self.public_ipv4_var.set("Checking…")
        self.public_ipv6_var.set("Checking…")
        self.local_ipv4_var.set("Checking…")
        self.local_ipv6_var.set("Checking…")
        self.host_addresses_var.set("Checking…")
        self.connectivity_var.set("Checking…")

        self.hostname_var.set(socket.gethostname())
        self.fqdn_var.set(socket.getfqdn())
        self.values["hostname"] = self.hostname_var.get()
        self.values["fqdn"] = self.fqdn_var.get()

        self._submit(
            "public_ipv4",
            lambda: fetch_public_ip(4),
            lambda value: self._set_simple_result(
                "public_ipv4", self.public_ipv4_var, "Public IPv4", value
            ),
        )
        self._submit(
            "public_ipv6",
            lambda: fetch_public_ip(6),
            lambda value: self._set_simple_result(
                "public_ipv6", self.public_ipv6_var, "Public IPv6", value
            ),
        )
        self._submit(
            "local_ipv4",
            lambda: get_primary_local_ip(4),
            lambda value: self._set_simple_result(
                "local_ipv4", self.local_ipv4_var, "LAN IPv4", value
            ),
        )
        self._submit(
            "local_ipv6",
            lambda: get_primary_local_ip(6),
            lambda value: self._set_simple_result(
                "local_ipv6", self.local_ipv6_var, "LAN IPv6", value
            ),
        )
        self._submit(
            "host_addresses",
            get_hostname_addresses,
            self._hostname_addresses_ready,
        )
        self._submit(
            "connectivity",
            probe_connectivity,
            self._connectivity_ready,
        )

    def _set_simple_result(
        self,
        key: str,
        variable: tk.StringVar,
        history_label: str,
        value: str,
    ) -> None:
        variable.set(value)
        self.values[key] = value
        self._record_history(history_label, value, "OK")

    def _hostname_addresses_ready(self, result: dict[str, object]) -> None:
        self.values["hostname_addresses"] = result
        self.values["hostname"] = result.get("hostname")
        self.values["fqdn"] = result.get("fqdn")
        self.hostname_var.set(str(result.get("hostname", "Unknown")))
        self.fqdn_var.set(str(result.get("fqdn", "Unknown")))

        ipv4 = result.get("ipv4", [])
        ipv6 = result.get("ipv6", [])
        pieces = []
        if ipv4:
            pieces.append("IPv4 " + ", ".join(ipv4))
        if ipv6:
            pieces.append("IPv6 " + ", ".join(ipv6))
        display = "  |  ".join(pieces) if pieces else "No hostname addresses found"
        self.host_addresses_var.set(display)
        self._record_history("Host addresses", display, "OK")

    def _connectivity_ready(self, result: dict[str, object]) -> None:
        self.values["connectivity"] = result
        display = (
            f"{result['status']}  |  DNS {result['dns_ms']} ms"
            f"  |  TCP {result['tcp_ms']} ms"
        )
        self.connectivity_var.set(display)
        self._record_history("Connectivity", display, "OK")

    def _task_failed(self, key: str, exc: BaseException) -> None:
        message = safe_error_message(exc)
        field_map = {
            "public_ipv4": (self.public_ipv4_var, "Public IPv4"),
            "public_ipv6": (self.public_ipv6_var, "Public IPv6"),
            "local_ipv4": (self.local_ipv4_var, "LAN IPv4"),
            "local_ipv6": (self.local_ipv6_var, "LAN IPv6"),
            "host_addresses": (self.host_addresses_var, "Host addresses"),
            "connectivity": (self.connectivity_var, "Connectivity"),
            "lookup": (None, "Lookup"),
        }

        variable, label = field_map.get(key, (None, key))
        if variable is not None:
            variable.set("Unavailable")
            self.values[key] = {
                "status": "unavailable",
                "error": message,
            }

        if key == "lookup":
            self._set_lookup_text(f"Lookup failed\n\n{message}")

        self._record_history(label, message, "ERROR")

    # ----------------------------
    # Lookup
    # ----------------------------

    def run_lookup(self) -> None:
        target = self.lookup_var.get().strip()
        if not target:
            self.status_var.set("Enter a hostname or IP address to inspect")
            self.lookup_entry.focus_set()
            return

        if "lookup" in self.pending:
            self.status_var.set("A lookup is already running")
            return

        self._set_lookup_text(f"Looking up {target}…")
        self.status_var.set(f"Looking up {target}…")
        self._submit(
            "lookup",
            lambda: lookup_target(target),
            self._lookup_ready,
        )

    def _lookup_ready(self, result: dict[str, object]) -> None:
        lines: list[str] = []
        query_type = result["query_type"]

        if query_type == "hostname":
            lines.append(f"Query: {result['query']}")
            lines.append(f"Type: hostname")
            ascii_hostname = result.get("ascii_hostname")
            if ascii_hostname and ascii_hostname != result["query"]:
                lines.append(f"IDNA/ASCII: {ascii_hostname}")
            lines.append("")

            addresses = result.get("addresses", [])
            for index, details in enumerate(addresses, start=1):
                lines.append(f"[{index}] IPv{details['version']}  {details['address']}")
                lines.append(
                    "    "
                    f"global={details['is_global']}  "
                    f"private={details['is_private']}  "
                    f"loopback={details['is_loopback']}  "
                    f"link-local={details['is_link_local']}  "
                    f"multicast={details['is_multicast']}"
                )
                lines.append(f"    reverse pointer: {details['reverse_pointer']}")
                lines.append("")
            display_for_history = ", ".join(
                str(item["address"]) for item in addresses
            )
        else:
            details = result["details"]
            lines.extend(
                [
                    f"Query: {result['query']}",
                    "Type: IP address",
                    f"Version: IPv{details['version']}",
                    f"Compressed: {details['compressed']}",
                    f"Exploded: {details['exploded']}",
                    f"Reverse pointer: {details['reverse_pointer']}",
                    f"Reverse DNS: {result.get('reverse_dns') or 'No PTR result'}",
                    "",
                    "Properties:",
                    f"  Global:      {details['is_global']}",
                    f"  Private:     {details['is_private']}",
                    f"  Loopback:    {details['is_loopback']}",
                    f"  Link-local:  {details['is_link_local']}",
                    f"  Multicast:   {details['is_multicast']}",
                    f"  Reserved:    {details['is_reserved']}",
                    f"  Unspecified: {details['is_unspecified']}",
                ]
            )
            aliases = result.get("aliases") or []
            if aliases:
                lines.append(f"Aliases: {', '.join(aliases)}")
            display_for_history = str(details["address"])

        self._set_lookup_text("\n".join(lines).rstrip())
        self._record_history("Lookup", display_for_history, "OK")

    def _set_lookup_text(self, text: str) -> None:
        self.lookup_text.configure(state="normal")
        self.lookup_text.delete("1.0", "end")
        self.lookup_text.insert("1.0", text)
        self.lookup_text.configure(state="disabled")

    def clear_lookup(self) -> None:
        self.lookup_var.set("")
        self._set_lookup_text(
            "Enter a hostname such as example.com or an IP address, then press Lookup."
        )
        self.lookup_entry.focus_set()

    def _focus_lookup(self, _event=None):
        self.notebook.select(self.lookup_tab)
        self.lookup_entry.focus_set()
        return "break"

    # ----------------------------
    # History, clipboard and export
    # ----------------------------

    def _record_history(self, item: str, value: str, status: str) -> None:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.history_tree.insert("", 0, values=(now, item, value, status))

        children = self.history_tree.get_children()
        if len(children) > self.history_limit:
            for iid in children[self.history_limit:]:
                self.history_tree.delete(iid)

    def copy_value(self, key: str, display_value: str) -> None:
        value = self.values.get(key, display_value)

        if isinstance(value, (dict, list)):
            text = json.dumps(value, indent=2, ensure_ascii=False)
        elif value is None:
            text = display_value
        else:
            text = str(value)

        if not text or text in {"Checking…", "Not checked", "Unavailable"}:
            self.status_var.set("Nothing useful to copy yet")
            return

        self.clipboard_clear()
        self.clipboard_append(text)
        self.status_var.set("Copied to clipboard")

    def copy_history_selected(self) -> None:
        selection = self.history_tree.selection()
        if not selection:
            self.status_var.set("Select a history row first")
            return
        values = self.history_tree.item(selection[0], "values")
        text = "\t".join(str(value) for value in values)
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status_var.set("History row copied")

    def clear_history(self) -> None:
        for iid in self.history_tree.get_children():
            self.history_tree.delete(iid)
        self.status_var.set("History cleared")

    def _report_data(self) -> dict[str, object]:
        history = []
        for iid in self.history_tree.get_children():
            values = self.history_tree.item(iid, "values")
            history.append(
                {
                    "time": values[0],
                    "item": values[1],
                    "value": values[2],
                    "status": values[3],
                }
            )

        return {
            "application": {
                "name": APP_NAME,
                "version": APP_VERSION,
            },
            "generated_at": utc_timestamp(),
            "system": {
                "platform": platform.platform(),
                "python": platform.python_version(),
                "hostname": socket.gethostname(),
                "fqdn": socket.getfqdn(),
            },
            "network": self.values,
            "history": history,
        }

    def copy_report(self) -> None:
        text = json.dumps(self._report_data(), indent=2, ensure_ascii=False)
        self.clipboard_clear()
        self.clipboard_append(text)
        self.status_var.set("Full JSON report copied")

    def export_report(self) -> None:
        suggested = f"netscope-report-{datetime.now().strftime('%Y%m%d-%H%M%S')}.json"
        filename = filedialog.asksaveasfilename(
            title="Export NetScope report",
            initialfile=suggested,
            defaultextension=".json",
            filetypes=[("JSON report", "*.json"), ("All files", "*.*")],
        )
        if not filename:
            return

        try:
            Path(filename).write_text(
                json.dumps(self._report_data(), indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except OSError as exc:
            messagebox.showerror(
                "Export failed",
                f"Could not save the report.\n\n{exc}",
                parent=self,
            )
            return

        self.status_var.set(f"Report exported: {filename}")

    # ----------------------------
    # Auto refresh and theme
    # ----------------------------

    def _auto_refresh_changed(self, _event=None) -> None:
        self._schedule_auto_refresh()
        seconds = AUTO_REFRESH_OPTIONS[self.auto_refresh_var.get()]
        if seconds:
            self.status_var.set(f"Auto refresh enabled every {seconds} seconds")
        else:
            self.status_var.set("Auto refresh disabled")

    def _schedule_auto_refresh(self) -> None:
        if self.auto_refresh_after_id is not None:
            try:
                self.after_cancel(self.auto_refresh_after_id)
            except tk.TclError:
                pass
            self.auto_refresh_after_id = None

        seconds = AUTO_REFRESH_OPTIONS.get(self.auto_refresh_var.get(), 0)
        if seconds:
            self.auto_refresh_after_id = self.after(
                seconds * 1000,
                self._auto_refresh_tick,
            )

    def _auto_refresh_tick(self) -> None:
        self.auto_refresh_after_id = None
        if not self.pending:
            self.refresh_all()
        self._schedule_auto_refresh()

    def toggle_theme(self) -> None:
        self.theme_mode = "light" if self.theme_mode == "dark" else "dark"
        self._apply_theme()

    # ----------------------------
    # Shutdown
    # ----------------------------

    def _on_close(self) -> None:
        if self.auto_refresh_after_id is not None:
            try:
                self.after_cancel(self.auto_refresh_after_id)
            except tk.TclError:
                pass

        try:
            self.executor.shutdown(wait=False, cancel_futures=True)
        except TypeError:
            self.executor.shutdown(wait=False)

        self.destroy()


def main() -> None:
    app = NetScopeApp()
    app.mainloop()


if __name__ == "__main__":
    main()
