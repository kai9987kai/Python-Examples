class NetworkError(RuntimeError):
    """Raised when a network operation cannot produce a valid result."""


def utc_timestamp() -> str:
    """Return an ISO-8601 UTC timestamp."""
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def safe_error_message(exc: BaseException) -> str:
    """Convert exceptions into concise messages suitable for the GUI."""
    if isinstance(exc, HTTPError):
        return f"HTTP {exc.code}: {exc.reason}"
    if isinstance(exc, URLError):
        reason = getattr(exc, "reason", exc)
        return f"Network error: {reason}"
    if isinstance(exc, socket.gaierror):
        return f"DNS/host resolution error: {exc}"
    if isinstance(exc, socket.timeout):
        return "Network operation timed out"
    if isinstance(exc, OSError):
        return f"OS/network error: {exc}"
    return f"{type(exc).__name__}: {exc}"


def fetch_public_ip(version: int) -> str:
    """
    Fetch and validate the public IPv4 or IPv6 address over HTTPS.

    ipify provides separate IPv4-only and IPv6-only endpoints.
    """
    if version not in (4, 6):
        raise ValueError("IP version must be 4 or 6")

    url = PUBLIC_IPV4_URL if version == 4 else PUBLIC_IPV6_URL
    request = Request(
        url,
        headers={
            "User-Agent": f"{APP_NAME}/{APP_VERSION}",
            "Accept": "application/json",
            "Cache-Control": "no-cache",
        },
        method="GET",
    )

    with urlopen(request, timeout=HTTP_TIMEOUT) as response:
        charset = response.headers.get_content_charset() or "utf-8"
        payload = json.loads(response.read().decode(charset))

    raw_ip = str(payload.get("ip", "")).strip()
    if not raw_ip:
        raise NetworkError("Public IP service returned no IP address")

    parsed = ipaddress.ip_address(raw_ip)
    if parsed.version != version:
        raise NetworkError(
            f"Expected IPv{version}, but service returned IPv{parsed.version}"
        )
    return str(parsed)


def get_primary_local_ip(version: int) -> str:
    """
    Determine the preferred local source address for an outbound route.

    UDP connect() selects a route/source address without sending application data.
    """
    if version not in ROUTE_PROBES:
        raise ValueError("IP version must be 4 or 6")

    family, target = ROUTE_PROBES[version]
    sock = socket.socket(family, socket.SOCK_DGRAM)
    sock.settimeout(2.5)
    try:
        sock.connect(target)
        local = sock.getsockname()[0]
    finally:
        sock.close()

    parsed = ipaddress.ip_address(local)
    if parsed.version != version:
        raise NetworkError(f"Could not determine primary IPv{version} address")
    return str(parsed)


def get_hostname_addresses() -> dict[str, list[str]]:
    """Resolve the computer hostname and return unique local IPv4/IPv6 addresses."""
    hostname = socket.gethostname()
    fqdn = socket.getfqdn()

    addresses: dict[int, set[str]] = {4: set(), 6: set()}
    results = socket.getaddrinfo(
        hostname,
        None,
        family=socket.AF_UNSPEC,
        type=socket.SOCK_STREAM,
    )

    for family, _, _, _, sockaddr in results:
        if family not in (socket.AF_INET, socket.AF_INET6):
            continue
        raw = sockaddr[0].split("%", 1)[0]
        try:
            parsed = ipaddress.ip_address(raw)
        except ValueError:
            continue
        addresses[parsed.version].add(str(parsed))

    def sorter(value: str) -> tuple[int, int]:
        obj = ipaddress.ip_address(value)
        return (0 if obj.is_loopback else 1, int(obj))

    return {
        "hostname": hostname,
        "fqdn": fqdn,
        "ipv4": sorted(addresses[4], key=sorter),
        "ipv6": sorted(addresses[6], key=sorter),
    }


def probe_connectivity() -> dict[str, float | str]:
    """
    Run two lightweight diagnostics:
    - DNS resolution for example.com
    - TCP connection setup to Cloudflare 1.1.1.1:443
    """
    dns_start = time.perf_counter()
    socket.getaddrinfo(
        "example.com",
        443,
        family=socket.AF_UNSPEC,
        type=socket.SOCK_STREAM,
    )
    dns_ms = (time.perf_counter() - dns_start) * 1000.0

    tcp_start = time.perf_counter()
    with socket.create_connection(("1.1.1.1", 443), timeout=3.0):
        pass
    tcp_ms = (time.perf_counter() - tcp_start) * 1000.0

    return {
        "status": "Online",
        "dns_ms": round(dns_ms, 1),
        "tcp_ms": round(tcp_ms, 1),
    }


def classify_ip(ip_text: str) -> dict[str, object]:
    """Return useful standards-based properties of an IP address."""
    obj = ipaddress.ip_address(ip_text)
    return {
        "address": str(obj),
        "version": obj.version,
        "compressed": obj.compressed,
        "exploded": obj.exploded,
        "reverse_pointer": obj.reverse_pointer,
        "is_global": obj.is_global,
        "is_private": obj.is_private,
        "is_loopback": obj.is_loopback,
        "is_link_local": obj.is_link_local,
        "is_multicast": obj.is_multicast,
        "is_reserved": obj.is_reserved,
        "is_unspecified": obj.is_unspecified,
    }


def lookup_target(target: str) -> dict[str, object]:
    """Resolve a hostname or inspect an IP address without third-party geolocation."""
    target = target.strip()
    if not target:
        raise ValueError("Enter a hostname or IP address")

    try:
        parsed = ipaddress.ip_address(target.split("%", 1)[0])
    except ValueError:
        # Hostname lookup.
        ascii_target = target.encode("idna").decode("ascii")
        results = socket.getaddrinfo(
            ascii_target,
            None,
            family=socket.AF_UNSPEC,
            type=socket.SOCK_STREAM,
        )
        ips: set[str] = set()
        for family, _, _, _, sockaddr in results:
            if family in (socket.AF_INET, socket.AF_INET6):
                raw = sockaddr[0].split("%", 1)[0]
                try:
                    ips.add(str(ipaddress.ip_address(raw)))
                except ValueError:
                    pass

        if not ips:
            raise NetworkError("No IPv4 or IPv6 addresses were returned")

        ordered = sorted(ips, key=lambda value: (ipaddress.ip_address(value).version, int(ipaddress.ip_address(value))))
        details = [classify_ip(value) for value in ordered]
        return {
            "query_type": "hostname",
            "query": target,
            "ascii_hostname": ascii_target,
            "addresses": details,
        }

    # IP inspection + best-effort reverse DNS.
    reverse_name = None
    aliases: list[str] = []
    try:
        reverse_name, aliases, _ = socket.gethostbyaddr(str(parsed))
    except (socket.herror, socket.gaierror, OSError):
        pass

    return {
        "query_type": "ip",
        "query": target,
        "details": classify_ip(str(parsed)),
        "reverse_dns": reverse_name,
        "aliases": aliases,
    }


